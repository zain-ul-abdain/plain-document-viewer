{
  "description": "Plain Viewer test corpus. Paths are relative to tests/corpus. 'generated: true' files are created by 'npm run generate:large' and are not in git.",
  "listener": "Hostile fixtures point at http://127.0.0.1:47831 and \\\\127.0.0.1@47831\\share. Run tests/harness/request-listener.mjs while testing; any recorded request is a failure.",
  "expectedResults": "result: open | error | password. error: damaged | empty | mismatch | unsupported | password-cancelled.",
  "fixtures": [
    {
      "id": "codex-simple-txt",
      "file": "simple.txt",
      "format": "txt",
      "category": "simple",
      "expect": {
        "result": "open",
        "text": [
          "Hello from Plain Viewer."
        ]
      },
      "producer": "Codex file-writing tool",
      "licence": "Authored for this project by Codex (see SOURCES.md)",
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      }
    },
    {
      "id": "codex-complex-txt",
      "file": "complex.txt",
      "format": "txt",
      "category": "complex",
      "expect": {
        "result": "open"
      },
      "producer": "Codex file-writing tool",
      "licence": "Authored for this project by Codex (see SOURCES.md)",
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      }
    },
    {
      "id": "codex-simple-csv",
      "file": "simple.csv",
      "format": "csv",
      "category": "simple",
      "expect": {
        "result": "open",
        "rows": 3,
        "columns": 3,
        "cells": [
          {
            "row": 2,
            "column": 1,
            "text": "001"
          }
        ]
      },
      "producer": "Codex file-writing tool",
      "licence": "Authored for this project by Codex (see SOURCES.md)",
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      }
    },
    {
      "id": "codex-complex-csv",
      "file": "complex.csv",
      "format": "csv",
      "category": "complex",
      "expect": {
        "result": "open",
        "columns": 3
      },
      "producer": "Codex file-writing tool",
      "licence": "Authored for this project by Codex (see SOURCES.md)",
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      }
    },
    {
      "id": "codex-simple-md",
      "file": "simple.md",
      "format": "md",
      "category": "simple",
      "expect": {
        "result": "open",
        "text": [
          "Hello"
        ]
      },
      "producer": "Codex file-writing tool",
      "licence": "Authored for this project by Codex (see SOURCES.md)",
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      }
    },
    {
      "id": "codex-complex-markdown",
      "file": "complex.markdown",
      "format": "md",
      "category": "complex",
      "expect": {
        "result": "open",
        "text": [
          "Hello"
        ]
      },
      "producer": "Codex file-writing tool",
      "licence": "Authored for this project by Codex (see SOURCES.md)",
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      }
    },
    {
      "id": "pdf-simple",
      "file": "pdf/simple.pdf",
      "format": "pdf",
      "category": "simple",
      "producer": "pdfkit 0.20.2 (Node)",
      "licence": "Generated by this repository; no third-party content",
      "expect": {
        "result": "open",
        "pages": 1,
        "text": [
          "Hello from Plain Viewer"
        ]
      },
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      }
    },
    {
      "id": "pdf-complex",
      "file": "pdf/complex.pdf",
      "format": "pdf",
      "category": "complex",
      "producer": "pdfkit 0.20.2 (Node)",
      "licence": "Generated by this repository; no third-party content",
      "expect": {
        "result": "open",
        "pages": 5,
        "text": [
          "Hello complex PDF",
          "Quarterly summary",
          "Sindh"
        ],
        "searchCounts": {
          "Sindh": 2
        }
      },
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none",
        "links": "http://127.0.0.1:47831/pdf-complex/link must only open after confirmation"
      }
    },
    {
      "id": "pdf-password",
      "file": "pdf/password.pdf",
      "format": "pdf",
      "category": "password",
      "producer": "pdfkit 0.20.2 (Node)",
      "licence": "Generated by this repository; no third-party content",
      "password": "viewer-test",
      "expect": {
        "result": "password",
        "afterPassword": {
          "pages": 1,
          "text": [
            "Hello secret PDF"
          ]
        }
      },
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      }
    },
    {
      "id": "pdf-truncated",
      "file": "pdf/damaged-truncated.pdf",
      "format": "pdf",
      "category": "damaged",
      "producer": "pdfkit 0.20.2 (Node), then truncated",
      "licence": "Generated by this repository; no third-party content",
      "expect": {
        "result": "error",
        "error": "damaged"
      },
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      },
      "notes": "Some readers can recover early pages from a truncated file; either a clear damaged-file message or a partial view without a crash is acceptable."
    },
    {
      "id": "pdf-zero-byte",
      "file": "pdf/zero-byte.pdf",
      "format": "pdf",
      "category": "empty",
      "producer": "generator (empty file)",
      "licence": "Generated by this repository; no third-party content",
      "expect": {
        "result": "error",
        "error": "empty"
      },
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      }
    },
    {
      "id": "pdf-mismatch",
      "file": "pdf/not-a-pdf.pdf",
      "format": "pdf",
      "category": "wrong-extension",
      "producer": "generator (text)",
      "licence": "Generated by this repository; no third-party content",
      "expect": {
        "result": "error",
        "error": "mismatch"
      },
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      }
    },
    {
      "id": "attack-pdf-javascript",
      "file": "pdf/attack-javascript.pdf",
      "format": "pdf",
      "category": "attack",
      "producer": "hand-written PDF (generator)",
      "licence": "Generated by this repository; no third-party content",
      "expect": {
        "result": "open",
        "pages": 1,
        "text": [
          "Hello script test"
        ]
      },
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none"
      },
      "notes": "OpenAction and page-open JavaScript call the listener. Any request under /pdf-javascript/ is a failure."
    },
    {
      "id": "attack-pdf-links",
      "file": "pdf/attack-links.pdf",
      "format": "pdf",
      "category": "attack",
      "producer": "hand-written PDF (generator)",
      "licence": "Generated by this repository; no third-party content",
      "expect": {
        "result": "open",
        "pages": 1,
        "text": [
          "Hello link test"
        ]
      },
      "rules": {
        "network": "none",
        "sourceUnchanged": true,
        "filesBesideSource": "none",
        "links": "Only the web address may open, and only after confirmation. Nothing is contacted while opening or scrolling."
      },
      "notes": "Manual check: click each link. Automated check: opening makes no request to the listener."
    }
  ]
}
