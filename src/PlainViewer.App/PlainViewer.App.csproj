<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><AssemblyName>PlainViewer</AssemblyName><ApplicationIcon>Assets\app.ico</ApplicationIcon></PropertyGroup>
  <!-- The window icon comes from the app itself (development runs start through dotnet.exe, whose icon would show). -->
  <ItemGroup><Resource Include="Assets\app.ico" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../PlainViewer.Core/PlainViewer.Core.csproj" /><ProjectReference Include="../PlainViewer.Worker/PlainViewer.Worker.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <ItemGroup><Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" /><Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <!-- PDF view: WebView2 SDK plus PDF.js 6.3.289 (Apache-2.0) served from the app's own folder. -->
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" /></ItemGroup>
  <ItemGroup><Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <!-- Two tiny documents OfficeConverter.Prewarm converts once to build LibreOffice's profile (from the generated test corpus). -->
  <ItemGroup>
    <Content Include="../../tests/corpus/docx/simple.docx" Link="Assets/prewarm/prewarm-word.docx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../tests/corpus/pptx/simple.pptx" Link="Assets/prewarm/prewarm-slides.pptx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyWorker" AfterTargets="Build"><ItemGroup><WorkerFiles Include="../PlainViewer.Worker/bin/$(Configuration)/net10.0-windows/*" /></ItemGroup><Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(OutDir)worker" /></Target>
</Project>
